#usda 1.0
# Modified by the openusd Ruby project only to normalize trailing whitespace.

over "refSphere" (
    prepend references = @HelloWorld.usda@
)
{
    uniform token[] xformOpOrder = []
}

over "refSphere2" (
    prepend references = @HelloWorld.usda@
)
{
    over "world"
    {
        color3f[] primvars:displayColor = [(1, 0, 0)]
    }
}
